      "gpt-5.6-luna",
      "gpt-5.4",
      "gpt-5.5",
      "gpt-5.4-mini",
      "gpt-5.3",
      "gpt-5.2",
      "gpt-5-mini",
      "o3",
      "o4-mini",
      "gpt-5"
    ],
    "credential_env": "CODEX_API_KEY",
    "agent": "codex"
  }
